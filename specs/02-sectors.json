{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 230,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b6664",
      "titleColor": "#384844",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 400,
      "gridColor": "#e5e8e2",
      "domain": false,
      "tickColor": "#cbd2cb",
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelColor": "#394943",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "padding": 6
    },
    "title": {
      "anchor": "start",
      "color": "#163e35"
    }
  },
  "data": {
    "url": "data/sectors.json"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3,
        "size": 34
      },
      "encoding": {
        "x": {
          "field": "schools",
          "type": "quantitative",
          "title": "Number of schools",
          "scale": {
            "domain": [
              0,
              1800
            ]
          }
        },
        "y": {
          "field": "sector",
          "type": "nominal",
          "title": null,
          "sort": [
            "Government",
            "Catholic",
            "Independent"
          ]
        },
        "color": {
          "field": "sector",
          "type": "nominal",
          "scale": {
            "domain": [
              "Government",
              "Catholic",
              "Independent"
            ],
            "range": [
              "#23766b",
              "#bc6046",
              "#c49b31"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "sector",
            "title": "Sector",
            "type": "nominal"
          },
          {
            "field": "schools",
            "title": "Schools",
            "format": ",d",
            "type": "quantitative"
          },
          {
            "field": "fte",
            "title": "Enrolment (FTE)",
            "format": ",.1f",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#163e35"
      },
      "encoding": {
        "x": {
          "field": "schools",
          "type": "quantitative"
        },
        "y": {
          "field": "sector",
          "type": "nominal",
          "title": null,
          "sort": [
            "Government",
            "Catholic",
            "Independent"
          ]
        },
        "text": {
          "field": "schools",
          "format": ",d"
        }
      }
    }
  ]
}