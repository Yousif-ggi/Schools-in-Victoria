{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 460,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b6664",
      "titleColor": "#384844",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 400,
      "gridColor": "#e5e8e2",
      "domain": false,
      "tickColor": "#cbd2cb",
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelColor": "#394943",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "padding": 6
    },
    "title": {
      "anchor": "start",
      "color": "#163e35"
    }
  },
  "params": [
    {
      "name": "sector",
      "value": "All sectors",
      "bind": {
        "input": "select",
        "options": [
          "All sectors",
          "Government",
          "Catholic",
          "Independent"
        ],
        "name": "Sector "
      }
    },
    {
      "name": "kind",
      "value": "All types",
      "bind": {
        "input": "select",
        "options": [
          "All types",
          "Primary",
          "Secondary",
          "Pri/Sec",
          "Special",
          "Language"
        ],
        "name": "School type "
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/victoria-map.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6ebe3",
        "stroke": "#fff",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/schools.json"
      },
      "transform": [
        {
          "filter": "(sector === 'All sectors' || datum.sector === sector) && (kind === 'All types' || datum.type === kind)"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 19,
        "opacity": 0.7,
        "stroke": "#fff",
        "strokeWidth": 0.25
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "sector",
          "type": "nominal",
          "scale": {
            "domain": [
              "Government",
              "Catholic",
              "Independent"
            ],
            "range": [
              "#23766b",
              "#bc6046",
              "#c49b31"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "symbolType": "circle"
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "School",
            "type": "nominal"
          },
          {
            "field": "sector",
            "title": "Sector",
            "type": "nominal"
          },
          {
            "field": "type",
            "title": "Type",
            "type": "nominal"
          },
          {
            "field": "lga",
            "title": "LGA",
            "type": "nominal"
          },
          {
            "field": "fte",
            "title": "Enrolment (FTE)",
            "format": ",.1f",
            "type": "quantitative"
          }
        ]
      }
    }
  ]
}