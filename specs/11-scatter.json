{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 350,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b6664",
      "titleColor": "#384844",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 400,
      "gridColor": "#e5e8e2",
      "domain": false,
      "tickColor": "#cbd2cb",
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelColor": "#394943",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "padding": 6
    },
    "title": {
      "anchor": "start",
      "color": "#163e35"
    }
  },
  "data": {
    "url": "data/lgas.json"
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 85,
        "color": "#23766b",
        "opacity": 0.72,
        "stroke": "#fff",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "children",
          "type": "quantitative",
          "title": "Residents aged 5–19",
          "axis": {
            "format": "~s"
          }
        },
        "y": {
          "field": "fte",
          "type": "quantitative",
          "title": "Enrolment in local schools (FTE)",
          "axis": {
            "format": "~s"
          }
        },
        "tooltip": [
          {
            "field": "lga",
            "title": "LGA",
            "type": "nominal"
          },
          {
            "field": "children",
            "title": "Residents aged 5–19",
            "format": ",d",
            "type": "quantitative"
          },
          {
            "field": "fte",
            "title": "Local-school FTE",
            "format": ",.1f",
            "type": "quantitative"
          },
          {
            "field": "schools",
            "title": "Schools",
            "format": ",d",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "indexof(['Casey','Wyndham','Boroondara','Melton'], datum.lga) >= 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": -8,
        "fontSize": 10,
        "color": "#163e35"
      },
      "encoding": {
        "x": {
          "field": "children",
          "type": "quantitative"
        },
        "y": {
          "field": "fte",
          "type": "quantitative"
        },
        "text": {
          "field": "lga"
        }
      }
    }
  ]
}