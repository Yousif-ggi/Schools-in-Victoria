{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 455,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b6664",
      "titleColor": "#384844",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 400,
      "gridColor": "#e5e8e2",
      "domain": false,
      "tickColor": "#cbd2cb",
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelColor": "#394943",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "padding": 6
    },
    "title": {
      "anchor": "start",
      "color": "#163e35"
    }
  },
  "data": {
    "url": "data/cartogram.json"
  },
  "encoding": {
    "x": {
      "field": "x",
      "type": "quantitative",
      "title": null,
      "axis": null,
      "scale": {
        "domain": [
          -12,
          543.6008182379635
        ]
      }
    },
    "y": {
      "field": "y",
      "type": "quantitative",
      "title": null,
      "axis": null,
      "scale": {
        "domain": [
          458.166959764391,
          -12
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "stroke": "#fff",
        "strokeWidth": 1,
        "opacity": 0.92
      },
      "encoding": {
        "size": {
          "field": "children",
          "type": "quantitative",
          "title": "Residents aged 5–19",
          "scale": {
            "range": [
              0,
              6500
            ],
            "domain": [
              0,
              90000
            ]
          },
          "legend": {
            "orient": "bottom",
            "values": [
              5000,
              25000,
              80000
            ],
            "format": "~s"
          }
        },
        "color": {
          "value": "#23766b"
        },
        "tooltip": [
          {
            "field": "lga",
            "title": "LGA",
            "type": "nominal"
          },
          {
            "field": "children",
            "title": "Residents aged 5–19",
            "format": ",d",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.children > 50000"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 9,
        "fill": "#fff",
        "fontWeight": 500
      },
      "encoding": {
        "text": {
          "field": "lga"
        }
      }
    }
  ]
}