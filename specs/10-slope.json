{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b6664",
      "titleColor": "#384844",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 400,
      "gridColor": "#e5e8e2",
      "domain": false,
      "tickColor": "#cbd2cb",
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelColor": "#394943",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "padding": 6
    },
    "title": {
      "anchor": "start",
      "color": "#163e35"
    }
  },
  "data": {
    "url": "data/history.json"
  },
  "transform": [
    {
      "filter": "datum.year === 2017 || datum.year === 2026"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 80
        },
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0
          },
          "scale": {
            "padding": 0.2
          }
        },
        "y": {
          "field": "schools",
          "type": "quantitative",
          "title": "Number of schools",
          "scale": {
            "domain": [
              0,
              1800
            ]
          }
        },
        "color": {
          "field": "sector",
          "type": "nominal",
          "scale": {
            "domain": [
              "Government",
              "Catholic",
              "Independent"
            ],
            "range": [
              "#23766b",
              "#bc6046",
              "#c49b31"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "symbolType": "circle"
          }
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year",
            "type": "nominal"
          },
          {
            "field": "sector",
            "title": "Sector",
            "type": "nominal"
          },
          {
            "field": "schools",
            "title": "Schools",
            "format": ",d",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -12,
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "schools",
          "type": "quantitative"
        },
        "text": {
          "field": "schools",
          "format": ",d"
        },
        "color": {
          "field": "sector",
          "type": "nominal",
          "scale": {
            "domain": [
              "Government",
              "Catholic",
              "Independent"
            ],
            "range": [
              "#23766b",
              "#bc6046",
              "#c49b31"
            ]
          },
          "legend": null
        }
      }
    }
  ]
}